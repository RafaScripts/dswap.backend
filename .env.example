# App
PORT=3000
NODE_ENV=development

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=dswap
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRATION=7d

# CoinMarketCap
CMC_API_KEY=your_coinmarketcap_api_key
CMC_BASE_URL=https://pro-api.coinmarketcap.com

# Swap
SWAP_FEE_PERCENTAGE=0.5
SWAP_MATCH_TIMEOUT_MINUTES=10
SWAP_DEPOSIT_TIMEOUT_MINUTES=30
SWAP_MIN_CONFIRMATIONS_EVM=3
SWAP_MIN_CONFIRMATIONS_SOLANA=1

# Blockchain RPCs
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_RPC_URL=https://bsc-dataseed.binance.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Escrow Hot Wallets (NUNCA commitar private keys — usar vault ou KMS)
ESCROW_ETHEREUM_ADDRESS=0x...
ESCROW_POLYGON_ADDRESS=0x...
ESCROW_ARBITRUM_ADDRESS=0x...
ESCROW_BSC_ADDRESS=0x...
ESCROW_SOLANA_ADDRESS=...

# Hot Wallet Private Keys (usar AWS KMS, HashiCorp Vault, ou .env local APENAS para dev)
# EM PRODUÇÃO: usar KMS para assinar transações, NUNCA armazenar em .env
# ESCROW_ETHEREUM_PRIVATE_KEY=
# ESCROW_SOLANA_PRIVATE_KEY=
